# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

source 'https://github.com/CocoaPods/Specs.git'
platform :ios, '17.0'
prepare_react_native_project!

# pod 'boost_custom', :podspec => './custom_podspecs/boost.podspec'


# NOTE: Flipper support (and FlipperConfiguration) was removed from React Native's own
# Podfile helpers as of ~0.74+ (replaced by React Native DevTools). The old
# `flipper_config = FlipperConfiguration.disabled` line and `:flipper_configuration` kwarg
# below no longer exist in RN 0.78.3's react_native_pods.rb and were removed accordingly.

# Use static frameworks for React Native Firebase compatibility
# This is required for Firebase to work properly with React Native
use_frameworks! :linkage => :static

target 'VaultTemp' do
  config = use_native_modules!
  # pod 'Firebase/Core', :modular_headers => true

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    # RN 0.78's use_react_native! defaults new_arch_enabled to TRUE unless told otherwise
    # (NewArchitectureHelper.new_arch_enabled returns true whenever RCT_NEW_ARCH_ENABLED is
    # unset). We deliberately stay on the Old Architecture here, matching Android's
    # newArchEnabled=false in gradle.properties — see the RN-upgrade plan's rationale
    # (react-native-fast-image has zero New Architecture support).
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'VaultTempTests' do
    inherit! :complete
    # Pods for testing
  end


  # pre_install do |installer|
  #   installer.pod_targets.each do |pod|
  #     if pod.name == 'boost'
  #       pod.instance_variable_set(:@spec, nil)
  #     end
  #   end
  # end

  post_install do |installer|
    # Fix for BoringSSL-GRPC: source files include <openssl_grpc/...> but headers
    # are installed under <openssl/...> — create a symlink to bridge the gap
    require 'fileutils'
    boringssl_include = File.join(installer.sandbox.root, 'BoringSSL-GRPC/src/include')
    openssl_grpc_dir  = File.join(boringssl_include, 'openssl_grpc')
    openssl_dir       = File.join(boringssl_include, 'openssl')
    if Dir.exist?(openssl_dir) && !File.exist?(openssl_grpc_dir)
      FileUtils.ln_s(openssl_dir, openssl_grpc_dir)
      puts "Created symlink: openssl_grpc -> openssl"
    end

    # Fix for fmt (RCT-Folly dependency): fmt 11.0.2's FMT_USE_CONSTEVAL auto-detection
    # enables `consteval` for Apple Clang >= 14, but Clang 21 (Xcode 27) has a regression
    # where fmt's compile-time format-string validation ("call to consteval function ...
    # is not a constant expression") fails to compile. There's no supported way to override
    # FMT_USE_CONSTEVAL via a compiler -D flag since base.h unconditionally redefines it
    # with a plain #define (no #ifndef guard), so patch the vendored header directly.
    # This only disables compile-time format-string checking (a dev-experience nicety);
    # format strings are still validated at runtime.
    fmt_base_h = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base_h)
      contents = File.read(fmt_base_h)
      patched = contents.gsub('#  define FMT_USE_CONSTEVAL 1', '#  define FMT_USE_CONSTEVAL 0')
      if patched != contents
        File.chmod(0644, fmt_base_h) # CocoaPods vendors this file read-only
        File.write(fmt_base_h, patched)
        puts "Patched fmt/base.h: forced FMT_USE_CONSTEVAL 0 (Clang 21 consteval regression workaround)"
      end
    end

    # Fix for gRPC module map issue
    grpc_headers_dir = File.join(installer.sandbox.root, 'Headers/Private/grpc')
    grpc_modulemap_src = File.join(installer.sandbox.root, 'Target Support Files/gRPC-Core/gRPC-Core.modulemap')
    grpc_modulemap_dst = File.join(grpc_headers_dir, 'gRPC-Core.modulemap')
    
    if File.exist?(grpc_modulemap_src)
      FileUtils.mkdir_p(grpc_headers_dir)
      FileUtils.cp(grpc_modulemap_src, grpc_modulemap_dst)
    end
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        # Global fix for Clang 21 (Xcode 26) segfaults across all C++ pod targets
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -O0 -Wno-error'
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -O0 -Wno-error'
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
        
        # Fix for non-modular header errors with use_frameworks!
        # Allow non-modular includes for React Native and related pods. Broadened to also
        # match the "RN"-prefix convention used by most community native modules (RNGestureHandler,
        # RNScreens, RNSVG, etc.) since they hit the exact same private-Fabric-header visibility
        # issue (e.g. RNGestureHandler.mm importing <React/RCTViewComponentView.h> and still
        # getting "use of undeclared identifier" under Clang's strict module boundaries).
        if target.name.include?('React') || target.name.include?('RCT') || target.name.include?('react-native') || target.name.start_with?('RN')
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          # Add ReactCommon header search paths for bridging and other headers
          react_native_path = File.join(__dir__, '..', 'node_modules', 'react-native')
          react_native_abs = File.expand_path(react_native_path)
          if Dir.exist?(react_native_abs)
            config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
            config.build_settings['HEADER_SEARCH_PATHS'] << File.join(react_native_abs, 'ReactCommon')
          end
        end
        
        # Fix for react-native-image-picker: ImagePickerManager.mm transitively pulls in
        # <folly/dynamic.h> via React's headers, but doesn't get RCT-Folly's include path
        # automatically under use_frameworks! :linkage => :static, causing "folly/dynamic.h
        # file not found" -> cascading "could not build module 'React'". Also needs the same
        # standard Folly compiler flags every other RN pod gets via RCT-Folly dependency
        # (its own podspec doesn't declare that dependency, so it inherits none of this) --
        # without -DFOLLY_NO_CONFIG, folly/portability/Config.h unconditionally includes the
        # generated <folly/folly-config.h>, which doesn't exist as a real vendored file.
        if target.name == 'react-native-image-picker'
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          # Full standard Folly-adjacent header set (matches what React-Core/RNGestureHandler
          # etc. get automatically via their RCT-Folly podspec dependency).
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/boost'
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/DoubleConversion'
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/fast_float/include'
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/fmt/include'
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/RCT-Folly'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1 -Wno-comma -Wno-shorten-64-to-32'
        end

        
        # Fix for react-native-vision-camera
        if target.name == 'VisionCamera'
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
          # Add header search paths for React Native headers including bridging
          react_native_path = File.join(__dir__, '..', 'node_modules', 'react-native')
          react_native_abs = File.expand_path(react_native_path)
          if Dir.exist?(react_native_abs)
            config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
            # Add ReactCommon root for bridging headers (react/bridging/...)
            config.build_settings['HEADER_SEARCH_PATHS'] << File.join(react_native_abs, 'ReactCommon')
            config.build_settings['HEADER_SEARCH_PATHS'] << File.join(react_native_abs, 'ReactCommon', 'react', 'nativemodule', 'core', 'platform', 'ios')
            config.build_settings['HEADER_SEARCH_PATHS'] << File.join(react_native_abs, 'React')
          end
        end
        
        # Fix for abseil (Firebase/gRPC dependency) — needs c++20 with Clang 16+ (Xcode 16)
        if target.name == 'abseil'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
          config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          config.build_settings['GCC_C_LANGUAGE_STANDARD'] = 'c11'
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        end

        # Fix for gRPC and related C++ libraries
        if target.name.include?('gRPC') || target.name.include?('BoringSSL-GRPC') || target.name.include?('leveldb')
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
          config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
          # Fix clang segfault (Segmentation fault: 11) with Xcode 26 / Clang 21
          config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -O0 -Wno-error'
          config.build_settings['OTHER_CFLAGS'] = '$(inherited) -O0 -Wno-error'
          config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
          # Exclude x86_64 simulator — Clang 21 segfaults on gRPC posix_engine for x86_64
          config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
        end

        # Add abseil header search paths so gRPC-Core can find absl/log/check.h etc.
        if target.name == 'gRPC-Core'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << File.join(installer.sandbox.root, 'Headers/Public/abseil')
          config.build_settings['HEADER_SEARCH_PATHS'] << File.join(installer.sandbox.root, 'Headers/Public')
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/abseil'
          config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/Headers/Public/abseil'
        end
        
        # Fix for Firebase Swift compatibility with Xcode 26 / Swift 6
        if target.name.include?('Firebase') || target.name.include?('RNFB') || target.name.include?('GoogleUtilities') || target.name.include?('GoogleAppMeasurement')
          config.build_settings['SWIFT_VERSION'] = '5.0'
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
          config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -disable-availability-checking'
          # Fix for Command Libtool failed with static frameworks
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        end

        # Fix for FirebaseAuth Libtool failure with use_frameworks! :linkage => :static
        if target.name == 'FirebaseAuth'
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
          config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
        end
        
        # Fix for react-native-worklets-core
        if target.name == 'react-native-worklets-core'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
          # Add header search paths for React Native headers
          react_native_path = File.join(__dir__, '..', 'node_modules', 'react-native')
          # Convert to absolute path and ensure it exists
          react_native_abs = File.expand_path(react_native_path)
          if Dir.exist?(react_native_abs)
            config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
            # The ReactCommon headers are at: ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/
            # Import is: <ReactCommon/RCTTurboModule.h>
            # So we need the parent of the ReactCommon directory
            common_path = File.join(react_native_abs, 'ReactCommon', 'react', 'nativemodule', 'core', 'platform', 'ios')
            if Dir.exist?(common_path)
              config.build_settings['HEADER_SEARCH_PATHS'] << common_path
            end
            # Also add React and ReactCommon root
            config.build_settings['HEADER_SEARCH_PATHS'] << File.join(react_native_abs, 'React')
            config.build_settings['HEADER_SEARCH_PATHS'] << File.join(react_native_abs, 'ReactCommon')
          end
        end
      end
    end
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Add source-based header paths so headers are found even before pod frameworks
    # are compiled in a clean Xcode build (avoids dependency on PODS_CONFIGURATION_BUILD_DIR)
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        existing = config_file.attributes['HEADER_SEARCH_PATHS'] || '$(inherited)'
        paths_to_add = []

        # React Native source headers
        paths_to_add << '"$(PODS_ROOT)/../../node_modules/react-native/Libraries/AppDelegate"' unless existing.include?('Libraries/AppDelegate')
        paths_to_add << '"$(PODS_ROOT)/../../node_modules/react-native/React/Base"'            unless existing.include?('React/Base')
        paths_to_add << '"$(PODS_ROOT)/../../node_modules/react-native"'                       unless existing.include?('node_modules/react-native"')

        # Firebase pod source headers — avoids needing pre-built frameworks for <Firebase*.h> imports
        firebase_public_dirs = Dir.glob(File.join(installer.sandbox.root, 'Firebase*', '**', 'Public'))
        firebase_public_dirs.each do |dir|
          pods_rel = dir.sub(installer.sandbox.root.to_s + '/', '')
          path_entry = "\"$(PODS_ROOT)/#{pods_rel}\""
          paths_to_add << path_entry unless existing.include?(pods_rel)
        end

        unless paths_to_add.empty?
          config_file.attributes['HEADER_SEARCH_PATHS'] = existing + ' ' + paths_to_add.join(' ')
          xcconfig_path = "#{aggregate_target.support_files_dir}/#{aggregate_target.label}.#{config_name}.xcconfig"
          config_file.save_as(Pathname.new(xcconfig_path))
        end
      end
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      end
      if target.name == 'RNScreens'
        target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end

    # Fix: App Store Connect/TestFlight rejects archives with "did not include a dSYM for
    # hermes.framework" -- Meta's prebuilt Hermes Release tarball genuinely ships without one
    # (react-native/scripts/hermes/hermes-utils.js strips dSYMs when Meta packages the
    # artifact), and since hermes.framework is vendored rather than compiled from source,
    # Xcode's normal per-target DEBUG_INFORMATION_FORMAT setting can't generate one for it
    # either. Regenerate it at archive time by running dsymutil directly against the vendored
    # binary (works as long as the binary keeps its embedded symbol table, which it does --
    # only the separate .dSYM companion was stripped, not the binary's own debug info).
    installer.aggregate_targets.each do |aggregate_target|
      next unless aggregate_target.label == 'Pods-VaultTemp'
      aggregate_target.user_project.native_targets.each do |native_target|
        next unless native_target.name == 'VaultTemp'
        phase_name = 'Generate Hermes dSYM'
        next if native_target.shell_script_build_phases.any? { |p| p.name == phase_name }
        phase = native_target.new_shell_script_build_phase(phase_name)
        phase.shell_script = <<-SCRIPT.gsub(/^ {10}/, '')
          if [ "${CONFIGURATION}" = "Release" ]; then
            HERMES_XCFRAMEWORK="${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/hermes.xcframework"
            HERMES_BINARY="${HERMES_XCFRAMEWORK}/ios-arm64/hermes.framework/hermes"
            if [ -f "$HERMES_BINARY" ]; then
              mkdir -p "${DWARF_DSYM_FOLDER_PATH}"
              dsymutil "$HERMES_BINARY" -o "${DWARF_DSYM_FOLDER_PATH}/hermes.framework.dSYM"
              echo "Generated hermes.framework.dSYM at ${DWARF_DSYM_FOLDER_PATH}"
            else
              echo "warning: hermes binary not found at $HERMES_BINARY -- skipping dSYM generation"
            fi
          fi
        SCRIPT
      end
      aggregate_target.user_project.save
    end

  end
end

