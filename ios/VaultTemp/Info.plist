	<!--
	  Minimal scene manifest: only declares scene support (required by newer SDKs --
	  without this, "UIScene life cycle is required for apps built with this SDK" is a
	  launch-blocking failure, not just a warning). Deliberately does NOT set
	  UISceneConfigurations/UISceneDelegateClassName: RCTAppDelegate (which our AppDelegate
	  extends) creates its window the legacy way, directly in
	  application:didFinishLaunchingWithOptions:, and never implements
	  scene:willConnectToSession:options:. Naming a scene delegate class here tells UIKit
	  to expect window setup via that callback instead, and since it's never implemented,
	  nothing happens on that path while the legacy path creates an unconnected window --
	  producing "Unbalanced calls to begin/end appearance transitions" and a launch screen
	  that never transitions to real content.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
